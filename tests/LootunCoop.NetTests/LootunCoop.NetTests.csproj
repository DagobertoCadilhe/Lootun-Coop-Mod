<Project Sdk="Microsoft.NET.Sdk">

  <!-- Loopback tests for src/Net (no game or Unity needed); see README for how to run.
       net472 is built too so API use stays compatible with the game's Mono runtime. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net472</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>LootunCoop.NetTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Net\**\*.cs" Link="Net\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
