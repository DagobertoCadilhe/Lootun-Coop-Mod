<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console stand-in for a second player, so the in-game host can be tested without a second copy of the game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net472;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>LootunCoop.TestClient</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Net\**\*.cs" Link="Net\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
